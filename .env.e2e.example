# Copy to .env.e2e and fill in values for a dedicated, disposable E2E database.
# Do not use the integration test database or a production database.
E2E_DATABASE_URL=postgresql://USER:PASSWORD@E2E_DATABASE_HOST:5432/E2E_DATABASE?sslmode=require
PRODUCTION_DATABASE_HOST=replace-with-production-database-hostname
PAYLOAD_SECRET=replace-with-a-development-only-random-secret-of-at-least-32-characters
