DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/komorebi_news_dev
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: Cloudflare R2 object storage (set all five values to enable it)
R2_BUCKET=komorebi-news-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://YOUR_BUCKET_PUBLIC_URL
